  "components": {
    "schemas": {
      "BlockBody": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "resource_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Resource Id"
          },
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Label"
          },
          "state": {
            "type": "string",
            "title": "State",
            "default": "absence"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end",
          "resource_id",
          "label"
        ],
        "title": "BlockBody"
      },
      "Confirm": {
        "properties": {
          "request": {
            "$ref": "#/components/schemas/Request"
          },
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          }
        },
        "type": "object",
        "required": [
          "request",
          "fingerprint"
        ],
        "title": "Confirm"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Question": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Question"
      },
      "Request": {
        "properties": {
          "production_id": {
            "type": "integer",
            "title": "Production Id"
          },
          "venue_id": {
            "type": "integer",
            "title": "Venue Id"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Спектакль",
              "Репетиция",
              "Генеральная репетиция",
              "Техническая репетиция",
              "Концерт",
              "Выездное мероприятие",
              "Монтаж"
            ],
            "title": "Kind",
            "default": "Спектакль"
          },
          "cast": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ],
            "title": "Cast",
            "default": "A"
          },
          "duration": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 480.0,
                "minimum": 15.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "scenes": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Scenes"
          },
          "adaptation": {
            "type": "boolean",
            "title": "Adaptation",
            "default": true
          },
          "replacements": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Replacements"
          },
          "equipment_kits": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Equipment Kits"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "override_reason": {
            "type": "string",
            "title": "Override Reason",
            "default": ""
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          },
          "notes": {
            "type": "string",
            "maxLength": 8000,
            "title": "Notes",
            "default": ""
          },
          "rehearsal_people": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rehearsal People"
          },
          "rehearsal_items": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Rehearsal Items"
          },
          "run_through": {
            "type": "boolean",
            "title": "Run Through",
            "default": false
          },
          "task_overrides": {
            "additionalProperties": {
              "$ref": "#/components/schemas/TaskTiming"
            },
            "type": "object",
            "title": "Task Overrides"
          }
        },
        "type": "object",
        "required": [
          "production_id",
          "venue_id",
          "start"
        ],
        "title": "Request"
      },
      "StatusChange": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "StatusChange"
      },
      "TaskTiming": {
        "properties": {
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "duration": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1440.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          }
        },
        "type": "object",
        "title": "TaskTiming"
      },
      "TimeSpan": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "TimeSpan"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}